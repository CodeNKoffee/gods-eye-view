{
  "name": "God's Eye View — private keyless",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "forwardPorts": [4173],
  "portsAttributes": {
    "4173": { "label": "God's Eye View", "onAutoForward": "notify", "protocol": "http", "visibility": "private" }
  },
  "postCreateCommand": "PUPPETEER_SKIP_DOWNLOAD=true npm ci && npm run doctor",
  "postStartCommand": "node .devcontainer/start.mjs",
  "remoteUser": "node",
  "customizations": { "codespaces": { "openFiles": ["README.md"] } }
}
